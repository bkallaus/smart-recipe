{
	"$schema": "https://biomejs.dev/schemas/2.4.4/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!.claude",
			"!.open-next",
			"!.wrangler",
			"!.superpowers",
			"!.next",
			"!public/sw.js"
		]
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"javascript": {
		"formatter": {
			"indentStyle": "space",
			"quoteStyle": "single",
			"jsxQuoteStyle": "single"
		}
	},
	"formatter": {
		"enabled": true
	},
	"linter": {
		"rules": {
			"suspicious": {
				"noExplicitAny": "warn",
				"noArrayIndexKey": "off"
			}
		}
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } }
}
