# Copy to .env.local for local development, and set the same variables in
# your hosting provider's environment settings for Preview and Production.

# Postgres (Neon) connection string.
DATABASE_URL=

# Signs the session cookie set after Google sign-in. Required: without it
# sign-in fails and every visitor is treated as signed out.
# Must be a random string of at least 32 characters, e.g.:
#   openssl rand -base64 48
SESSION_SECRET=

# OpenRouter API key used for AI recipe parsing.
OPENROUTER_API_KEY=
